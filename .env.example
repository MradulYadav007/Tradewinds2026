# Optional. Leave blank to serve public/media through your deployment's CDN.
# With https://cdn.example.com, /media/photo.webp becomes https://cdn.example.com/media/photo.webp.
VITE_MEDIA_BASE_URL=

# Optional final origin, for canonical URLs and sitemap.xml. No trailing path.
VITE_SITE_URL=

# VITE_ variables are PUBLIC, included at build time. Never put secrets here.

# Scoreboard (server-only — NOT prefixed with VITE_). Set these in Vercel → Project → Settings → Environment Variables.
# Password organizers type on /scoreboard/admin. Use a long, unguessable value.
SCOREBOARD_ADMIN_PASSWORD=
# Added automatically when you connect an Upstash Redis database from Vercel → Storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=
